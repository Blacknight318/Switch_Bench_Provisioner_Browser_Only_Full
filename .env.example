# Copy to .env, replace every value, then restrict access appropriately.
# Do not commit .env. Use placeholder values only in .env.example.

# Site identifiers and addressing
DOMAIN_NAME=example.invalid
MGMT_VLAN=99
ACCESS_VLAN_1=100
ACCESS_VLAN_2=120
NATIVE_VLAN=999
MGMT_IP=192.0.2.10
MGMT_MASK=255.255.255.0
MGMT_GATEWAY=192.0.2.1
# Comma-separated IPv4 addresses allowed to SSH to each switch.
# One through 100 unique addresses are supported; these generate ACL sequence lines 10, 20, 30, ...
MGMT_SSH_SOURCES=192.0.2.20,192.0.2.21,192.0.2.22

# Infrastructure endpoints
SYSLOG_SERVER_1=192.0.2.30
SYSLOG_PORT=514
NTP_SERVER_1=192.0.2.40
SNMP_MANAGER_HOST=192.0.2.50
SNMP_LOCATION=Example-Site-Closet-A
RADIUS_SERVER_1_NAME=RADIUS1
RADIUS_SERVER_1_HOST=192.0.2.60
RADIUS_SERVER_2_NAME=RADIUS2
RADIUS_SERVER_2_HOST=192.0.2.61

# Secrets and account names
ENABLE_SECRET=replace-with-a-unique-enable-secret
LOCAL_ADMIN_USERNAME=replace-with-local-admin-username
LOCAL_ADMIN_SECRET=replace-with-a-unique-local-admin-secret
RADIUS_SERVER_1_SECRET=replace-with-radius-shared-secret
RADIUS_SERVER_2_SECRET=replace-with-radius-shared-secret
SNMPV3_USERNAME=replace-with-snmpv3-username
SNMPV3_AUTH_PASSWORD=replace-with-snmpv3-auth-password
SNMPV3_PRIV_PASSWORD=replace-with-snmpv3-privacy-password
